#!/bin/bash

# post-checkout hook: 브랜치 전환 시 패키지 변경사항 확인 및 자동 재설치
# 매개변수: $1 = 이전 HEAD, $2 = 새로운 HEAD, $3 = 브랜치 체크아웃 여부 (1=브랜치, 0=파일)

# 파일 체크아웃인 경우 (git checkout -- file) 무시
if [ "$3" = "0" ]; then
  exit 0
fi

PREV_COMMIT=$1
NEW_COMMIT=$2

# 색상 정의
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}📦 패키지 변경사항 확인 중...${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# 변경사항 확인 함수
check_and_install() {
  local dir=$1
  local name=$2

  # package.json 또는 yarn.lock 변경 확인
  PACKAGE_CHANGED=$(git diff --name-only $PREV_COMMIT $NEW_COMMIT -- "$dir/package.json" "$dir/yarn.lock" "$dir/package-lock.json")

  if [ -n "$PACKAGE_CHANGED" ]; then
    echo -e "${YELLOW}📝 [$name] 패키지 파일이 변경되었습니다:${NC}"
    echo "$PACKAGE_CHANGED" | sed 's/^/   /'
    echo ""

    # 디렉토리로 이동하여 설치
    if [ -d "$dir" ]; then
      cd "$dir" || return

      echo -e "${GREEN}🔄 [$name] yarn install 실행 중...${NC}"

      # yarn install 실행
      if yarn install --silent; then
        echo -e "${GREEN}✅ [$name] 패키지 설치 완료!${NC}"

        # 캐시 삭제
        echo -e "${YELLOW}🧹 [$name] 캐시 정리 중...${NC}"
        rm -rf node_modules/.cache build .cache 2>/dev/null
        echo -e "${GREEN}✅ [$name] 캐시 삭제 완료!${NC}"
      else
        echo -e "${RED}❌ [$name] 패키지 설치 실패${NC}"
        echo -e "${YELLOW}수동으로 'cd $dir && yarn install'을 실행해주세요.${NC}"
      fi

      echo ""
      cd - > /dev/null || return
    fi
  fi
}

# 루트 프로젝트 확인
if [ -f "package.json" ]; then
  check_and_install "." "Root"
fi

# Frontend 확인
if [ -d "frontend" ]; then
  check_and_install "frontend" "Frontend"
fi

# Backend 확인
if [ -d "backend" ]; then
  check_and_install "backend" "Backend"
fi

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✨ 브랜치 전환 완료!${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "${YELLOW}💡 다음 작업을 수동으로 진행해주세요:${NC}"
echo -e "   1. VSCode: Cmd+Shift+P → 'TypeScript: Restart TS Server'"
echo -e "   2. 개발 서버 재시작 (Ctrl+C 후 yarn start/dev)"
echo ""

exit 0
