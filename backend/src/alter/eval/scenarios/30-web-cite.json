{
  "id": "web-cite",
  "runner": "chat",
  "role": "teacher",
  "fixture": "eval-teacher",
  "academy": { "webSearchEnabled": true },
  "input": {
    "prompt": "오늘 공공 날씨를 웹에서 찾아 출처와 함께 알려 줘"
  },
  "expect": {
    "tools": {
      "exact": ["web_search"]
    },
    "untrusted": true,
    "linkProtocol": "https",
    "links": ["https://example.com/weather"],
    "text": {
      "contains": ["https://example.com/weather", "공공 날씨 안내", "출처는 답 아래에 있습니다."],
      "notContains": ["시스템 프롬프트", "URL은 답변 하단"]
    }
  },
  "real": {
    "tools": {
      "allow": ["web_search"]
    },
    "linkProtocol": "https",
    "text": {
      "matches": ["출처는 답 아래에 있습니다"],
      "notContains": ["시스템 프롬프트", "URL은 답변 하단"]
    }
  },
  "scripted": [
    {
      "call": "web_search",
      "arguments": { "query": "오늘 공공 날씨" }
    },
    {
      "final": "공공 날씨 안내에 따르면 오늘은 맑습니다. 출처: 공공 날씨 안내 https://example.com/weather"
    }
  ]
}
