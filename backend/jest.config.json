{
  "rootDir": ".",
  "testMatch": ["**/tests/APIs/userAPI/**"],
  "testEnvironment": "node",
  "resetMocks": true,
  "clearMocks": true,
  "setupFiles": ["./src/env.js"],
  "moduleNameMapper": {
    "@models/(.*)$": "<rootDir>/src/models/$1",
    "@controllers/(.*)$": "<rootDir>/src/controllers/$1"
  }
}
