{
  "rootDir": ".",
  "testMatch": [
    "**/tests/APIs/userAPI/**",
    "**/tests/utils/**/*.test.js",
    "**/tests/services/**/*.test.js"
  ],
  "testEnvironment": "node",
  "resetMocks": true,
  "clearMocks": true,
  "setupFiles": ["./env.js"],
  "moduleNameMapper": {
    "@models/(.*)$": "<rootDir>/src/models/$1",
    "@controllers/(.*)$": "<rootDir>/src/controllers/$1"
  }
}
